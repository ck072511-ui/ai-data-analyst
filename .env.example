# ==============================================================================
# AI Data Analyst - Environment Configuration Template
# Copy this file to '.env' and populate with your own values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Set to 'development', 'testing', or 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Security Configuration
# ------------------------------------------------------------------------------
# MUST be set to a secure, random 32-character string in production.
# Keep this secret safe!
SECRET_KEY=development-secret-key-change-me-must-be-long-and-random-32-chars

# ------------------------------------------------------------------------------
# 3. Database Connectivity
# ------------------------------------------------------------------------------
# Development / Local PostgreSQL default:
DATABASE_URL=postgresql://analyst:secure_password@localhost:5432/analytics_db

# Production (docker-compose.prod.yml maps db hostname to 'postgres' container):
# DATABASE_URL=postgresql://analyst:secure_password@postgres:5432/analytics_db

# Local SQLite fallback default (used automatically if no PostgreSQL is configured):
# DATABASE_URL=sqlite:///./test_analytics.db

# Dynamic Database credentials encryption secret key
# (Used to encrypt/decrypt database connection credentials securely in Postgres)
DB_ENCRYPTION_KEY=my-encryption-key-must-be-32-url-safe-base64-bytes=

# ------------------------------------------------------------------------------
# 4. Redis Caching & Queue Broker
# ------------------------------------------------------------------------------
# Local Redis:
REDIS_URL=redis://localhost:6379/0

# Production (docker-compose.prod.yml maps cache hostname to 'redis' container):
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Set your OpenAI credentials here
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. Monitoring & Telemetry
# ------------------------------------------------------------------------------
# Slow queries logging threshold (milliseconds)
SLOW_QUERY_THRESHOLD_MS=100
PROMETHEUS_MULTIPROC_DIR=/tmp
